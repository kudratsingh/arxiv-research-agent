{
  "local": {
    "$defs": {
      "CompactChecksRevision": {
        "enum": [
          "workspace-assistance-compact-checks-v14"
        ],
        "title": "CompactChecksRevision",
        "type": "string"
      },
      "CompactClaimReview": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Concise material evidence or unresolved issue across the row judgments; <=120 JSON-encoded UTF-8 bytes locally.",
            "maxLength": 96,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "claim_id": {
            "enum": [
              "c1",
              "c2",
              "c3",
              "c4",
              "c5",
              "c6"
            ],
            "title": "Claim Id",
            "type": "string"
          },
          "input_digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Input Digest",
            "type": "string"
          },
          "decision": {
            "$ref": "#/$defs/SupportDecision"
          },
          "atomicity": {
            "enum": [
              "atomic",
              "bundled",
              "uncertain"
            ],
            "title": "Atomicity",
            "type": "string"
          },
          "qualifications": {
            "$ref": "#/$defs/Retention"
          }
        },
        "required": [
          "reason",
          "claim_id",
          "input_digest",
          "decision",
          "atomicity",
          "qualifications"
        ],
        "title": "CompactClaimReview",
        "type": "object"
      },
      "CompactPartReview": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Concise material evidence or unresolved issue across the row judgments; <=120 JSON-encoded UTF-8 bytes locally.",
            "maxLength": 96,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "part_id": {
            "enum": [
              "p1",
              "p2",
              "p3",
              "p4",
              "p5",
              "p6",
              "p7",
              "p8"
            ],
            "title": "Part Id",
            "type": "string"
          },
          "input_digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Input Digest",
            "type": "string"
          },
          "decision": {
            "enum": [
              "answered",
              "lacks_evidence",
              "omitted",
              "uncertain"
            ],
            "title": "Decision",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "part_id",
          "input_digest",
          "decision"
        ],
        "title": "CompactPartReview",
        "type": "object"
      },
      "CompactProseFinding": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Concise material evidence or unresolved issue across the row judgments; <=120 JSON-encoded UTF-8 bytes locally.",
            "maxLength": 96,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "field": {
            "enum": [
              "background",
              "assumptions",
              "comparison",
              "gaps",
              "questions",
              "proposal",
              "abstention"
            ],
            "title": "Field",
            "type": "string"
          },
          "index": {
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index"
          }
        },
        "required": [
          "reason",
          "field",
          "index"
        ],
        "title": "CompactProseFinding",
        "type": "object"
      },
      "Retention": {
        "additionalProperties": false,
        "properties": {
          "study_scope": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Study Scope",
            "type": "string"
          },
          "comparator": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Comparator",
            "type": "string"
          },
          "metric_definition": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Metric Definition",
            "type": "string"
          },
          "conditions": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Conditions",
            "type": "string"
          }
        },
        "required": [
          "study_scope",
          "comparator",
          "metric_definition",
          "conditions"
        ],
        "title": "Retention",
        "type": "object"
      },
      "SupportDecision": {
        "enum": [
          "supported",
          "unsupported",
          "abstain"
        ],
        "title": "SupportDecision",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "All judgments remain mandatory; a shared reason covers claim judgments.\n\nReasons concisely identify the material evidence or unresolved issue; their\nomission never defaults any support, atomicity or qualification judgment.\nUTF-8 byte bounds and semantic/binding checks are local validation duties,\nincluding where the SDK's transformed schema removes unsupported constraints.",
    "properties": {
      "revision": {
        "$ref": "#/$defs/CompactChecksRevision"
      },
      "claim_reviews": {
        "items": {
          "$ref": "#/$defs/CompactClaimReview"
        },
        "maxItems": 6,
        "title": "Claim Reviews",
        "type": "array"
      },
      "coverage_checks": {
        "items": {
          "$ref": "#/$defs/CompactPartReview"
        },
        "maxItems": 8,
        "title": "Coverage Checks",
        "type": "array"
      },
      "prose_review": {
        "enum": [
          "procedural_only",
          "unscored_factual_content",
          "abstain"
        ],
        "title": "Prose Review",
        "type": "string"
      },
      "prose_findings": {
        "items": {
          "$ref": "#/$defs/CompactProseFinding"
        },
        "maxItems": 10,
        "title": "Prose Findings",
        "type": "array"
      },
      "priority_review": {
        "enum": [
          "respected",
          "violated",
          "uncertain"
        ],
        "title": "Priority Review",
        "type": "string"
      }
    },
    "required": [
      "revision",
      "claim_reviews",
      "coverage_checks",
      "prose_review",
      "prose_findings",
      "priority_review"
    ],
    "title": "CompactChecks",
    "type": "object"
  },
