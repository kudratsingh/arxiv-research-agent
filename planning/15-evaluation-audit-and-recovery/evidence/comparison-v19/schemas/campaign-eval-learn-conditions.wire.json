    "ComparisonPart_417dacb5a34195ef": {
      "type": "object",
      "title": "ComparisonPart_417dacb5a34195ef",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "answered",
            "partial",
            "lacks_evidence",
            "omitted"
          ],
          "description": "answered: nonempty answer refs, [none]. partial: nonempty answer refs and genuine remaining gaps. lacks_evidence: no answer refs, evidence reasons. omitted: no answer refs, omission reasons. Context is never answer credit. For a comparison, answer IDs must name actual comparative findings citing each necessary selected source. Qualitative method contrasts do not need shared benchmarks; performance conclusions require compatible evaluation evidence. A source summary remains context when the comparison cannot be answered.",
          "title": "Status"
        },
        "gap_reasons": {
          "type": "array",
          "title": "Gap Reasons",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "application_context",
              "source_scope",
              "common_evaluation",
              "methods",
              "protocol",
              "data_splits",
              "metric_definition",
              "uncertainty_calibration",
              "memory_error_persistence",
              "claim_budget",
              "not_prioritized"
            ]
          },
          "minItems": 1,
          "description": "{maxItems: 10}"
        },
        "answer_claim_ids": {
          "type": "array",
          "title": "Answer Claim Ids",
          "items": {
            "type": "string",
            "enum": [
              "c1",
              "c2",
              "c3",
              "c4",
              "c5",
              "c6",
              "c7",
              "c8"
            ]
          },
          "description": "{maxItems: 8}"
        },
        "context_claim_ids": {
          "type": "array",
          "title": "Context Claim Ids",
          "items": {
            "type": "string",
            "enum": [
              "c1",
              "c2",
              "c3",
              "c4",
              "c5",
              "c6",
              "c7",
              "c8"
            ]
          },
          "description": "{maxItems: 8}"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "gap_reasons",
        "answer_claim_ids",
        "context_claim_ids"
      ]
    },
