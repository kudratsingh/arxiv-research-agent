              "c8"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Context Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "gap_reasons",
        "answer_claim_ids",
        "context_claim_ids"
      ],
      "title": "ComparisonPart_92db0cb7caf23a81",
      "type": "object"
    },
