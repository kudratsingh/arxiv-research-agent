{
  "local": {
    "$defs": {
      "ClaimKey": {
        "enum": [
          "c1",
          "c2",
          "c3",
          "c4",
          "c5",
          "c6",
          "c7",
          "c8",
          "c9",
          "c10",
          "c11",
          "c12"
        ],
        "title": "ClaimKey",
        "type": "string"
      },
      "ClaimReview": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Material evidence or unresolved issue; 240 characters is a soft target, not a hard limit. Never drop findings to fit.",
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "claim_id": {
            "$ref": "#/$defs/ClaimKey"
          },
          "input_digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Input Digest",
            "type": "string"
          },
          "decision": {
            "$ref": "#/$defs/SupportDecision"
          },
          "atomicity": {
            "enum": [
              "atomic",
              "bundled",
              "uncertain"
            ],
            "title": "Atomicity",
            "type": "string"
          },
          "qualifications": {
            "$ref": "#/$defs/Retention"
          }
        },
        "required": [
          "reason",
          "claim_id",
          "input_digest",
          "decision",
          "atomicity",
          "qualifications"
        ],
        "title": "ClaimReview",
        "type": "object"
      },
      "PartReview": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Material evidence or unresolved issue; 240 characters is a soft target, not a hard limit. Never drop findings to fit.",
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "part_id": {
            "enum": [
              "p1",
              "p2",
              "p3",
              "p4",
              "p5",
              "p6",
              "p7",
              "p8"
            ],
            "title": "Part Id",
            "type": "string"
          },
          "input_digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Input Digest",
            "type": "string"
          },
          "decision": {
            "enum": [
              "answered",
              "lacks_evidence",
              "omitted",
              "uncertain"
            ],
            "title": "Decision",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "part_id",
          "input_digest",
          "decision"
        ],
        "title": "PartReview",
        "type": "object"
      },
      "ProseFinding": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Material evidence or unresolved issue; 240 characters is a soft target, not a hard limit. Never drop findings to fit.",
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "field": {
            "enum": [
              "background",
              "assumptions",
              "comparison",
              "gaps",
              "questions",
              "proposal",
              "abstention"
            ],
            "title": "Field",
            "type": "string"
          },
          "index": {
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index"
          }
        },
        "required": [
          "reason",
          "field",
          "index"
        ],
        "title": "ProseFinding",
        "type": "object"
      },
      "Retention": {
        "additionalProperties": false,
        "properties": {
          "study_scope": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Study Scope",
            "type": "string"
          },
          "comparator": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Comparator",
            "type": "string"
          },
          "metric_definition": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Metric Definition",
            "type": "string"
          },
          "conditions": {
            "enum": [
              "retained",
              "lost",
              "not_reported",
              "not_applicable",
              "uncertain"
            ],
            "title": "Conditions",
            "type": "string"
          }
        },
        "required": [
          "study_scope",
          "comparator",
          "metric_definition",
          "conditions"
        ],
        "title": "Retention",
        "type": "object"
      },
      "SupportDecision": {
        "enum": [
          "supported",
          "unsupported",
          "abstain"
        ],
        "title": "SupportDecision",
        "type": "string"
      },
      "_ChecksRevision": {
        "enum": [
          "workspace-assistance-capacity-checks-v15"
        ],
        "title": "_ChecksRevision",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "revision": {
        "$ref": "#/$defs/_ChecksRevision"
      },
      "claim_reviews": {
        "items": {
          "$ref": "#/$defs/ClaimReview"
        },
        "maxItems": 12,
        "title": "Claim Reviews",
        "type": "array"
      },
      "coverage_checks": {
        "items": {
          "$ref": "#/$defs/PartReview"
        },
        "maxItems": 8,
        "title": "Coverage Checks",
        "type": "array"
      },
      "prose_review": {
        "enum": [
          "procedural_only",
          "unscored_factual_content",
          "abstain"
        ],
        "title": "Prose Review",
        "type": "string"
      },
      "prose_findings": {
        "items": {
          "$ref": "#/$defs/ProseFinding"
        },
        "maxItems": 16,
        "title": "Prose Findings",
        "type": "array"
      },
      "priority_review": {
        "enum": [
          "respected",
          "violated",
          "uncertain"
        ],
        "title": "Priority Review",
        "type": "string"
      }
    },
    "required": [
      "revision",
      "claim_reviews",
      "coverage_checks",
      "prose_review",
      "prose_findings",
      "priority_review"
    ],
    "title": "CompactChecks",
    "type": "object"
  },
