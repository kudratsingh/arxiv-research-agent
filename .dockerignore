# Same shape as .gitignore + everything the build doesn't need.
# Smaller build context = faster iteration.

.git/
.github/
.venv/
.cache/
.claude/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo

# Test + tooling — not in the image
tests/
docs/
planning/
CLAUDE-Agent-Proj-1.md
*.md
!README.md
# WO-W15: briefing companions are markdown *content*, not documentation.
# The blanket `*.md` above would strip every one of them out of the build
# context, and the learn endpoints would serve a path whose entries had
# no companion — the one failure the manifest schema cannot catch,
# because on disk the manifest would still be right.
!content/**/*.md

# Local runtime artifacts
outputs/
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# CI configs — not needed at build time
.pre-commit-config.yaml
