# Copy this file to the repository root as .env on the pilot host. The root
# .gitignore excludes .env. Leave required values empty until they are
# generated; Compose's :? guards refuse to boot with missing secrets.
#
# EVERY PROCEDURE THAT FILLS THIS FILE IS IN `docs/runbooks/pilot.md`. This
# file names the variables; the runbook says how to produce each value, in
# what order, and what must never be reused. Read it first — in particular
# the never-reassign rule, which is the one mistake this design cannot
# recover from.
#
# NOTHING HERE IS APPROVED TO RUN. W-OD-5 is open. Filling this file in is
# not the decision; the decision is the owner's, and it covers the invitee
# names, the deployment, the inference budget, the at-cap behaviour, and
# whether pilot keys keep POST /research rights.

# ------ Provider ----------------------------------------------------
# Paid provider credential. Every pilot session spends against this one
# account. Set an account budget and a project limit before it is real.
ANTHROPIC_API_KEY=

# ------ The pilot edge ----------------------------------------------
# Where the edge listens. A hostname turns on automatic HTTPS; a bare
# port (`:80`) serves plain HTTP and is for local use only.
PILOT_SITE_ADDRESS=
ACME_EMAIL=

# Path to the generated basic-auth file, one `username bcrypt-hash` line
# per pilot. Never committed; `.gitignore` excludes
# deploy/pilot/pilot-users.caddy. Generate with:
#   docker run --rm caddy:2.11.4-alpine caddy hash-password
PILOT_USERS_FILE=./deploy/pilot/pilot-users.caddy

# The topology guard. Shared by the edge and the web tier and by nothing
# else: without it the web tier refuses every forwarded username.
#   openssl rand -hex 32
PILOT_EDGE_SECRET=

# ------ The pilot principals ----------------------------------------
# Path to the backend keystore, `{"<key_id>": "<secret>", ...}`, one
# entry per pilot. Hot-reloaded: adding a pilot is an edit, revoking one
# is a deletion, and the latency is API_KEYS_RELOAD_INTERVAL_SEC. Never
# committed; `.gitignore` excludes deploy/pilot/pilot-keys.json.
PILOT_KEYSTORE_FILE=./deploy/pilot/pilot-keys.json
#API_KEYS_RELOAD_INTERVAL_SEC=30

# The web tier's username -> principal map, as ONE JSON document. At most
# five entries (SR-09); the web tier refuses to serve a sixth. `key_id`
# must equal the NAME half of that pilot's keystore entry and `api_key`
# the secret half — a mismatch means the pilot authenticates at the edge
# and then gets a 401 from the API.
#
#   PILOT_PRINCIPAL_MAP={"pilot-ada":{"key_id":"pilot-ada-2026-09","api_key":"sk_..."}}
PILOT_PRINCIPAL_MAP=

# ------ Spend guardrails (SR-09) ------------------------------------
# The terms of the worst-case arithmetic in docs/runbooks/pilot.md.
# Lower them before raising the cohort, never after.
MAX_COST_USD=2.00
API_KEY_HOURLY_LIMIT=20
LEARNING_SESSION_MAX_COST_USD=0.50
# refuse (default) or degraded_close. W-OD-5 chooses; record the choice
# in the Gate W2 pack.
LEARNING_SESSION_COST_CAP_BEHAVIOR=refuse

# ------ Database ----------------------------------------------------
# Postgres URL credential. Keep this hex so it needs no URL encoding:
# openssl rand -hex 32
POSTGRES_PASSWORD=

# ------ Content -----------------------------------------------------
# Off until the briefing campaign (W-OD-2) and its review are done.
#ENABLE_LEARN_CONTENT=false
