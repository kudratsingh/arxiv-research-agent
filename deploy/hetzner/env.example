# Copy this file to the repository root as .env on the VPS. The root
# .gitignore excludes .env. Leave required values empty until they are
# generated; Compose's :? guards refuse to boot with missing secrets.

# Paid provider credential. Do not run a live research job until its
# account budget and project limit are confirmed.
ANTHROPIC_API_KEY=

# Exact public hostname whose A/AAAA record points at the VPS.
APP_DOMAIN=
ACME_EMAIL=

# Human-facing Caddy login. Generate APP_PASSWORD_HASH interactively:
# docker run --rm -it caddy:2.11.4-alpine caddy hash-password
APP_USERNAME=
# Keep the hash single-quoted so Compose does not treat its dollar signs
# as interpolation. Example shape only: '$2a$14$...'
APP_PASSWORD_HASH=''

# Internal server-to-server API credential. Hex is URL/header safe:
# openssl rand -hex 32
WEB_API_KEY=

# Postgres URL credential. Keep this hex so it needs no URL encoding:
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Per-job and per-hour guardrails. These defaults can be lowered before
# the first live run without rebuilding the images.
MAX_COST_USD=2.00
API_KEY_HOURLY_LIMIT=20
