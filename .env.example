# Copy to .env and fill in. Every setting maps to a typed field in
# src/config.py (pydantic-settings, ADR 0011) — see that file for the
# full list, defaults, bounds, and per-field docs. Never commit .env.

# ------ Anthropic / LLM ---------------------------------------------
# Claude API key. The only variable required for a live run, and one of
# the four secrets here (API_KEYS, SEMANTIC_SCHOLAR_API_KEY and
# LOG_PRINCIPAL_SALT are the others): it is a SecretStr in
# src/config.py, so it renders as ********** in a repr, a settings dump
# or an assertion diff, and src/llm.py reads the real value once through
# get_secret_value(). Blank means "not configured" — the client refuses
# to build rather than calling with an empty key.
ANTHROPIC_API_KEY=your-api-key-here

# ------ Workflow ----------------------------------------------------
# Offline demo mode: built-in fixture papers instead of arXiv, AND a
# deterministic branch in every research agent, so the whole graph runs
# with no ANTHROPIC_API_KEY and makes no model call (ADR 0080). The
# briefing it produces opens with "Mock mode: fixture papers, no model
# call." and carries no quality signal. Set this to demo or develop
# without a credential; leave it false for any real run.
#USE_MOCK_DATA=false
# Per-run LLM spend ceiling in USD, enforced between graph nodes (ADR 0033/0051).
#MAX_COST_USD=2.00
# Cap on ranked paper count per run.
#MAX_PAPERS=10

# ------ Agent capability (CAP-02, ADR 0076) --------------------------
# Which research graph is compiled. legacy (default) is today's
# behaviour: the shape follows ENABLE_SUPERVISOR and nothing else.
# fixed_verify_repair is arm C — planner, search, reader, synthesizer,
# an explicit verify node, at most one deterministic repair on a failed
# verdict, then re-verification before the critic. It requires
# ENABLE_SUPERVISOR=false, ENABLE_EVIDENCE_STORE=true and
# ENABLE_VERIFIER=false; any other combination is refused at load with a
# message naming every offending flag. orchestrated_workers is the third
# value — the branch tier, described in its own block below (ADR 0086) —
# and it requires the same three flags.
#RESEARCH_POLICY=legacy

# ------ Agent capability (CAP-04, ADR 0085) --------------------------
# Whether each research job picks its own compute tier. off (the
# default) is today: one graph is compiled for the whole process and
# nothing below applies. deterministic compiles the fixed pipeline and
# the verify-and-repair graph once at startup, over one checkpointer,
# and selects between them per job from a pure rule table over the
# query — length, entity count, comparison and recency cues. T0 runs the
# fixed pipeline; T1 runs verify-and-repair. It requires
# RESEARCH_POLICY=legacy, ENABLE_SUPERVISOR=false and
# ENABLE_VERIFIER=false, because each of those already claims the shape
# the controller is choosing. ENABLE_EVIDENCE_STORE is *not* required
# and is strongly recommended: without it a T1 run's graph classifies as
# research_capability_missing rather than as arm C.
#COMPUTE_CONTROLLER=off
# Per-tier, per-agent effort, as JSON keyed "<tier>.<agent>". Outranks
# <AGENT>_EFFORT and LLM_EFFORT for that agent on that tier, and applies
# only while a run has a tier bound — so the empty default changes
# nothing whatever the controller is set to. `off` is not a member: this
# map raises effort on an escalated run, and <AGENT>_EFFORT=off already
# turns an agent's effort off everywhere. Every level is checked against
# that agent's routed model at load, as LLM_EFFORT is.
#TIER_EFFORT_OVERRIDES={"T1.verifier": "high"}
# T2 is deliberately not a valid key here: COMPUTE_TIERS is unextended
# by CAP-03 so that a deployment with the branch tier off accepts
# exactly what it accepted before (ADR 0086).

# ------ Agent capability (CAP-03, ADR 0086) --------------------------
# The branch tier. Two independent switches, answering two different
# questions.
#
# RESEARCH_POLICY=orchestrated_workers (set it above, beside the other
# RESEARCH_POLICY note) fixes the shape for the whole process:
# planner -> lead -> workers -> merge -> synthesizer, then the same
# verify / repair / critic stage arm C uses. Each worker researches one
# of the planner's sub-questions on an isolated state with its own
# branch_id, and the merge unions their evidence tables, deduplicates
# papers and records which branch and which sub-question found each one.
# It requires ENABLE_SUPERVISOR=false, ENABLE_EVIDENCE_STORE=true and
# ENABLE_VERIFIER=false, refused at load with a message naming every
# offending flag.
#
# ORCHESTRATION lets the compute controller choose the branch tier per
# run instead, as T2 — two extra rules: a three-way-or-worse comparison,
# and a plan broader than the planner's own range. Consulted only when
# COMPUTE_CONTROLLER=deterministic, and with it off the controller's
# rule table, reason codes and eligible tiers are exactly ADR 0085's.
#ORCHESTRATION=off
# Hard cap on worker branches per run. The lead takes the planner's
# sub-questions in order and stops here, so a longer plan loses its tail
# rather than driving unbounded retrieval.
#ORCHESTRATION_MAX_BRANCHES=4
# Hard cap on papers one branch reads, and therefore on the model calls
# it makes: the reader spends exactly one call per paper. Applied
# between search and reader, the only place it can bind.
#ORCHESTRATION_MAX_PAPERS_PER_BRANCH=4
# Fraction of MAX_COST_USD one branch may add before the shared cost
# choke point stops it. A containment device, not an allocation: the
# shares deliberately over-subscribe the ceiling, because the ceiling is
# the real bound and shares summing to 1.0 would starve later branches
# whenever an early one finished cheap. A branch that trips its share is
# recorded budget_stopped and the run continues with its siblings; a run
# that trips the ceiling gets the ordinary budget-stopped outcome with a
# partial report.
#ORCHESTRATION_BRANCH_COST_SHARE=0.4

# ------ Resilience (Phase A, ADR 0068) ------------------------------
# Retry amplification is the measured problem: three retries at five
# levels of a stack is 243x load on a dependency that is already
# failing. These bound *retries*, so a healthy deployment is unchanged.
# Kill switch. Off restores the pre-budget behaviour exactly: every
# request pays its full retry envelope during an outage.
#ENABLE_RETRY_BUDGET=true
# Retries one worker may spend per dependency before the budget starts
# refusing them, and how fast they come back (per second, plus a share
# per successful call — 0.2 means five successes buy one retry).
#RETRY_BUDGET_CAPACITY=100
#RETRY_BUDGET_REFILL_PER_SEC=1.0
#RETRY_BUDGET_SUCCESS_REFUND=0.2
# Ceiling on one HTTP backoff and the cap in the Full Jitter draw.
# urllib3's own default is 120s, a fifth of a default job budget.
#HTTP_BACKOFF_MAX_SEC=20.0
# Share of api_job_timeout_sec one HTTP call chain may occupy worst
# case. Retries are trimmed against it; llm.py gives the model 0.75.
#HTTP_CALL_CHAIN_BUDGET_FRACTION=0.25
# Per-attempt timeout on an arXiv request, and the pause between
# consecutive live queries in one run. The pause is interruptible by a
# job cancel; the timeout declares a 0.1% false-timeout budget.
#ARXIV_TIMEOUT_SEC=25.0
#ARXIV_PACING_SEC=3.0
# Per-attempt timeout on one PDF fetch. Unchanged from the module
# constant it replaces; declaring it is what lets the retry clamp see
# it, and at 60s the clamp trims PDF retries to 1.
#PDF_DOWNLOAD_TIMEOUT_SEC=60.0
# Redis connect/command timeouts, idle-connection health check, and the
# retries redis-py itself makes. Redis is the one owning level for
# Redis retries — no application loop may add a second.
#REDIS_CONNECT_TIMEOUT_SEC=5.0
#REDIS_SOCKET_TIMEOUT_SEC=5.0
#REDIS_HEALTH_CHECK_INTERVAL_SEC=30
#REDIS_MAX_RETRIES=1
# Requeues one job may receive before the redriver dead-letters it as
# internal_dead_letter. Without this bound an enabled
# JOB_REDRIVE_REQUEUE_PENDING is a poison-message loop.
#JOB_REDRIVE_MAX_ATTEMPTS=3

# ------ API auth ----------------------------------------------------
# Gate /research and /conversations behind the X-API-Key header.
# Off by default for local dev; turn on for any exposed deployment (ADR 0033).
#ENABLE_API_AUTH=false
# Comma-separated name:key pairs used when ENABLE_API_AUTH is on. A
# secret, and the densest one here — every key the deployment will
# accept, in one variable — so it is a SecretStr in src/config.py and
# never reaches a repr or a settings dump. src/api/auth.py's
# parse_api_keys is the only reader. A malformed entry is reported by
# position, not quoted, because an entry missing its ':' is a bare
# secret. Blank means unset, which is what the pilot overlay wants when
# API_KEYS_FILE is the keystore.
#API_KEYS=internal:sk_a123,partner:sk_b456
# Secret used only by the Next.js server-side /api proxy. Under auth-on
# Compose, this must equal the secret half of one API_KEYS entry.
#WEB_API_KEY=
# Path to a JSON keystore `{name: secret, ...}`. Overrides API_KEYS and
# hot-reloads on mtime change, so issuing and revoking a key needs no
# restart (ADR 0037). The pilot deployment uses this rather than
# API_KEYS — see docs/runbooks/pilot.md.
#API_KEYS_FILE=
#API_KEYS_RELOAD_INTERVAL_SEC=30

# ------ Pilot edge identity (Phase W, WO-W17, ADR 0063) --------------
# WEB-TIER settings, not src/config.py fields: they are read by
# web/lib/server/pilot.ts and passed to the `web` service, the same way
# WEB_API_KEY above is. Default OFF, and nothing on main turns them on.
#
# Only the literal `on` enables the mapping. Unset, empty and `off` are
# off; ANY OTHER VALUE makes the web tier refuse to serve, so "I turned
# it on" and "it is on" cannot disagree (MT-01 threat T6).
#PILOT_EDGE_AUTH=off
# The topology guard. The pilot edge echoes this in X-Pilot-Edge-Key and
# the web tier refuses every forwarded username without it. At least 32
# characters: openssl rand -hex 32
#PILOT_EDGE_SECRET=
# The username -> principal map, as ONE JSON document, at most five
# entries (SR-09; a sixth refuses to serve). `key_id` must equal the
# NAME half of that pilot's keystore entry, `api_key` the secret half.
# Never logged, never a build argument, never NEXT_PUBLIC_*.
#PILOT_PRINCIPAL_MAP={"pilot-ada":{"key_id":"pilot-ada-2026-09","api_key":"sk_..."}}
# WEB_API_KEY / ARXIV_API_KEY must be EMPTY when the map is set. Both
# configured is an ambiguity, and the web tier answers 503 rather than
# choosing one. deploy/pilot/ is the overlay; docs/runbooks/pilot.md is
# the procedure and the only thing that may issue a pilot.

# ------ Storage backends --------------------------------------------
# JobStore: memory (single-worker, jobs die with the process) or
# redis (shared, safe for horizontal scaling — ADR 0027).
#JOB_STORE=memory
# Async Redis URL used when JOB_STORE=redis (compose: redis://redis:6379/0).
#REDIS_URL=redis://localhost:6379/0
# ConversationStore: memory (in-process) or postgres (durable, cross-worker — ADR 0032).
#CONVERSATION_STORE=memory
# libpq-style Postgres URL for the paper/embedding caches and the
# postgres-backed stores. Empty = disabled (disk/no-op fallbacks).
#POSTGRES_URL=postgresql://arxiv:arxiv@localhost:5432/arxiv
# Compose database bootstrap values. Development defaults are shown;
# the production overlay requires a unique POSTGRES_PASSWORD.
#POSTGRES_USER=arxiv
#POSTGRES_PASSWORD=arxiv
#POSTGRES_DB=arxiv
# LangGraph checkpoints: sqlite (per-worker file) or postgres
# (shared; required for multi-worker HITL — ADR 0034).
#CHECKPOINT_BACKEND=sqlite

# ------ Learner surfaces (Phase W, ADR 0058) -------------------------
# Mount the per-learner stores and both /learn routes: the profile
# (WO-W02) and the progress ledger (WO-W07). Requires
# ENABLE_API_AUTH=true — both are keyed by the authenticated principal
# and refuse the anonymous one, so the pair fails at startup rather
# than per request. Off by default.
#ENABLE_LEARNER_PROFILE=false
# ProfileStore: memory (in-process) or postgres (durable, cross-worker).
#LEARNER_PROFILE_STORE=memory
# ProgressEventStore for the append-only progress ledger: memory
# (in-process) or postgres (durable; the append-only trigger and the
# no-mastery-scalar CHECK live in the table — WO-W07).
#PROGRESS_EVENT_STORE=memory

# ------ Learning sessions (Phase W, ADR 0057) ------------------------
# How long a `session` job waits in `awaiting_learner` for the
# learner's next turn before failing. The learner-facing mirror of
# API_HITL_TIMEOUT_SEC.
#SESSION_TURN_TIMEOUT_SEC=1800
# Ceiling on learner turns in one session job; also sizes the job's
# outer wall-clock backstop.
#SESSION_MAX_TURNS=40
# Mount the checkpointed guided-read session graph. Requires
# ENABLE_LEARNER_PROFILE=true and ENABLE_CHECKPOINTING=true.
#ENABLE_SESSION_LOOP=false
# Model for check-in and tutor turns. Empty = ANTHROPIC_MODEL.
#TUTOR_MODEL=
# One-shot explain-back judge. Requires ENABLE_SESSION_LOOP=true and remains
# tutor guidance until its calibration prior is owner-ratified. Off by default.
#ENABLE_ASSESSMENT_JUDGE=false
#ASSESSMENT_MODEL=
# Per-session ceiling. Research jobs continue to use MAX_COST_USD.
#LEARNING_SESSION_MAX_COST_USD=0.50
# At-cap product behavior: refuse (default) or degraded_close.
#LEARNING_SESSION_COST_CAP_BEHAVIOR=refuse

# ------ Telemetry ---------------------------------------------------
# Emit OpenTelemetry metrics (job counts/durations, LLM cost,
# concurrency gauges, rate-limit rejections — ADR 0049).
#ENABLE_METRICS=false
# OTLP HTTP endpoint shared by tracing + metrics. Empty = console exporter.
#OTEL_EXPORTER_ENDPOINT=http://localhost:4318
# Head-sampling ratio, 0.0-1.0. Unset (the default) installs no sampler at
# all, which leaves the SDK's own OTEL_TRACES_SAMPLER handling intact. Out
# of range is refused at settings load rather than clamped: 10 from
# somebody who meant 10% used to sample every trace and say nothing.
#TRACE_SAMPLE_RATIO=0.1
# Let user content — research queries, report bodies, paper text, learner
# writing — stay in the log stream and on spans instead of being elided.
# Off by default, which is what the OpenTelemetry GenAI conventions require.
# LOG_CAPTURE_USER_CONTENT is the same setting under its older repo-local
# name; the conventional name below wins if both are set. This is the one
# setting that can be flipped without a restart. See docs/observability.md.
#OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Deployment-wide salt for the principal_hash log field — what a log line
# carries instead of an API key id. Set the same value on every process
# and a principal's lines join across containers; leave it unset and each
# process invents its own at import, which groups within one process only.
# principal_salt_is_ephemeral() reports which of the two you have, and a
# blank value is unset rather than a salt. One of the four secrets here:
# it never reaches a log line, a repr or a settings dump. See
# docs/observability.md.
#LOG_PRINCIPAL_SALT=

# ------ Evaluation integrity (Phase A, ADR 0070) --------------------
# Model every LLM-as-judge metric is scored with. NOT a per-agent
# routing knob: it does not fall back to ANTHROPIC_MODEL, and an empty
# value is refused at settings load — inheriting the product model is
# the defect ADR 0070 closes. Changing this invalidates every existing
# baseline, because a diff across a judge swap compares two different
# instruments. Recorded on every summary row.
#EVAL_JUDGE_MODEL=claude-sonnet-4-6
# Seed applied to the harness's own generators at campaign start and
# recorded on every row. It pins local draws; it does NOT make a
# campaign reproducible — the Messages API exposes no sampling seed.
#EVAL_SEED=0

# ------ Learning content (Phase W, WO-W15) --------------------------
# Serve the repo-shipped learning paths over GET /learn/paths. Read-only,
# published+reviewed entries only; off by default, in which case the
# routes answer 404 learn_content_disabled.
#ENABLE_LEARN_CONTENT=false
# Directory holding paths/<path_id>/path.json. Empty = the content/
# directory shipped beside src/ in the repo and in the image.
#LEARN_CONTENT_ROOT=

# ------ Semantic Scholar (ADR 0023) ---------------------------------
# Enrich arXiv results with S2's citation graph. Off by default.
#ENABLE_SEMANTIC_SCHOLAR=false
# Optional S2 API key. Unset = the anonymous rate limit (~100 req /
# 5 min per IP); set = 1 req/sec sustained. A secret, so it is a
# SecretStr in src/config.py; src/tools/semantic_scholar.py's _headers
# is the only reader and puts the raw value straight into the x-api-key
# header. Blank means unset, not a blank key — S2 answers a bad key
# with 403 and enrichment would fail closed instead of falling back to
# anonymous.
#SEMANTIC_SCHOLAR_API_KEY=
# Top-ranked arXiv papers to expand, references fetched per seed, and
# the per-request timeout. Total S2 calls per run are bounded by the
# product of the first two.
#SEMANTIC_SCHOLAR_SEED_COUNT=3
#SEMANTIC_SCHOLAR_REFS_PER_SEED=3
#SEMANTIC_SCHOLAR_TIMEOUT_SEC=30.0

# ------ Agent capability (CAP-01, ADR 0077) -------------------------
# Model-aware request profiles. Every value below is what the gateway
# already sent before ADR 0077, so an untouched file changes nothing.
# Each field is sent only when the *resolved* model accepts it —
# src/llm_models.py is the table of what each model accepts.
#
# Adaptive thinking on every model call: off | adaptive. `adaptive`
# sends thinking={"type":"adaptive"} and lets the model decide how much
# to think. Refused at settings load when any routed model has no
# adaptive mode (Haiku 4.5, Opus 4.5), because that combination is an
# HTTP 400 on every call rather than a degraded one. It also changes
# the eval judges' requests, which re-baselines every metric (ADR 0070).
#LLM_THINKING=off
# Default output_config.effort: empty | low | medium | high | xhigh | max.
# Empty sends no effort field, which the API reads as `high`. Refused at
# load when a routed model does not list the level — Haiku 4.5 rejects
# effort outright and Sonnet 4.6 (the default model) has no `xhigh`.
#LLM_EFFORT=
# Per-agent overrides, mirroring the <AGENT>_MODEL fields above. Empty
# inherits LLM_EFFORT; `off` sends no effort field for that agent, which
# is the only way to run a global level while one agent routes to a
# model that rejects effort (ADR 0021 recommends Haiku for the reader).
#PLANNER_EFFORT=
#READER_EFFORT=
#SYNTHESIZER_EFFORT=
#CRITIC_EFFORT=
#VERIFIER_EFFORT=
#SUPERVISOR_EFFORT=
#QUERY_REFINER_EFFORT=
#TUTOR_EFFORT=
#ASSESSMENT_EFFORT=
# Ask the model for schema-valid JSON instead of parsing free text.
# Applies to the planner, critic, supervisor and verifier, and only on
# models that support it; everywhere else the existing parse path runs
# unchanged. Not refused at load on an unsupporting model, unlike
# thinking and effort, because it has a working fallback and they do not.
#ENABLE_STRUCTURED_OUTPUTS=false
# Sampling temperature, 0.0-1.0, sent only to models that accept
# sampling parameters. 0.3 is the constant the gateway hard-coded before
# ADR 0077. On Opus 4.7+, Opus 5, Sonnet 5 and the Fable/Mythos tier it
# is silently not sent — sending it there is an HTTP 400.
#LLM_TEMPERATURE=0.3

# ------ Misc --------------------------------------------------------
# Device for the MiniLM embedding model. cpu is the deliberate default
# (torch MPS has segfaulted under concurrent processes — ADR 0052).
#EMBEDDING_DEVICE=cpu
# Standard-library logging level name (DEBUG/INFO/WARNING/ERROR/CRITICAL).
#LOG_LEVEL=INFO
# Compose publishes app/web to loopback by default. Broaden only on a
# trusted network; production removes these publishes entirely.
#APP_BIND_ADDRESS=127.0.0.1
#WEB_BIND_ADDRESS=127.0.0.1

# ------ P0 contracts (W05, ADR 0078) --------------------------------
# Bind the TaskSpec / RunManifest / trajectory contracts to the research
# path. `off` (the default) disables every hook — no contract module is
# imported on the request path and the job, SSE and eval records are
# byte-identical to a build without the switch. `shadow` compiles a
# TaskSpec, seals a manifest before the first node and records an
# in-memory trajectory beside the run; it never changes graph input,
# graph output, job outcome, cost, or any persisted schema. There is no
# `enforce` value: refusing a run on a contract verdict is P0-WO07/W11
# work, after the shadow evidence has been reviewed.
#CONTRACT_SHADOW=off

# ------ P0 contracts (W08, ADR 0083) --------------------------------
# Whether canonical trajectory events reach a durable local sink. `off`
# (the default) keeps every event in memory, exactly as the W05 shadow
# did. `evaluation_only` enables a run-scoped JSONL sink for evaluation,
# public-source and synthetic episodes ONLY: a run carrying
# `product_operation_only` consent — which is what a real research job
# and a real learner session carry — is refused the sink whatever this
# is set to, because D8 (P0-WO09) has not authorized production or
# learner capture. There is deliberately no `production` value.
#CONTRACT_EVENT_CAPTURE=off
# Where that sink writes: one directory per run beneath
# `runs/<run_id>/`, holding run_scope.json, events.jsonl and head.json.
# Ignored entirely when capture is off.
#CONTRACT_EVENT_SINK_ROOT=outputs/trajectories
# One INFO line per canonical event. Off by default — the ledger is the
# record, and a line per event roughly doubles a job's log volume.
#CONTRACT_EVENT_LOG_PROJECTION=false
