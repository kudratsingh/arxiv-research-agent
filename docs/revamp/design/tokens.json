  "typography": {
    "families": {
      "ui": {
        "stack": "\"Atkinson Hyperlegible Next\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "license": "SIL Open Font License 1.1",
        "role": "Navigation, controls, forms, status, sub-question text, all interface copy",
        "weights": [400, 600, 700]
      },
      "report": {
        "stack": "Literata, ui-serif, Georgia, \"Times New Roman\", serif",
        "license": "SIL Open Font License 1.1",
        "role": "Markdown report body and headings, thread titles, landing prompt",
        "weights": [400, 600]
      },
      "mono": {
        "stack": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "license": "SIL Open Font License 1.1",
        "role": "Anything the machine reads or writes back literally: arXiv search-query fields, job ids, timestamps, error_type strings, metric values, diagnostic event rows, code spans in the report",
        "weights": [400, 500]
      }
    },
    "loading": {
      "strategy": "self-hosted woff2, latin subset, font-display: swap",
      "fallbackMetrics": "size-adjust / ascent-override / descent-override must be MEASURED per family against the declared fallback and verified at CLS = 0 in the Lighthouse gate. No invented values are recorded here.",
      "cls-budget": "0.00 (baseline is 0.00 across all six audited states)"
    },
    "scale": {
      "ui-xs": { "size": "12px", "line": "16px", "tracking": "0.005em", "use": "Utility labels, metric captions, timestamps" },
      "ui-sm": { "size": "14px", "line": "20px", "tracking": "0", "use": "Dense UI, thread rows, helper text, buttons" },
      "ui-base": { "size": "16px", "line": "24px", "tracking": "0", "use": "Body UI and all text inputs (16px avoids iOS focus zoom)" },
      "ui-lg": { "size": "18px", "line": "26px", "tracking": "-0.005em", "use": "Section headings in the workbench chrome" },
      "ui-xl": { "size": "22px", "line": "28px", "tracking": "-0.01em", "use": "Thread title (h1) in the workspace header" },
      "report-small": { "size": "15px", "line": "1.5", "use": "Report tables, captions, footnotes" },
      "report-body": { "size": "17px", "line": "1.65", "use": "Report paragraphs; measure capped at 68ch" },
      "report-h3": { "size": "18px", "line": "1.35", "weight": 600 },
      "report-h2": { "size": "22px", "line": "1.30", "weight": 600 },
      "report-h1": { "size": "27px", "line": "1.25", "weight": 600 },
      "display": { "size": "34px", "line": "1.18", "tracking": "-0.015em", "use": "Landing prompt only; one per page" },
      "mono-xs": { "size": "12px", "line": "16px", "use": "Job ids, timestamps, metric values" },
      "mono-sm": { "size": "13px", "line": "20px", "use": "arXiv search-query inputs, diagnostic event rows" }
    },
    "rules": [
      "Minimum rendered text size is 12px anywhere in the product. The baseline's 10.4px job-id label is removed.",
      "Uppercase is allowed only for single-word or two-word eyebrow labels, never for a sentence.",
      "The report never uses the UI family; the UI chrome never uses the report family. The typeface tells the reader whether they are looking at the product or at the briefing it produced.",
      "Sub-questions render in the UI family (human language, editable prose). Search queries render in the mono family (literal strings sent to arXiv). This is a semantic distinction, not decoration."
    ]
  },

  "space": {
    "unit": "4px",
    "scale": {
      "space-0": "0",
      "space-05": "2px",
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px",
      "space-24": "96px"
    },
    "layout": {
      "gutter-narrow": "16px",
      "gutter-wide": "32px",
      "rail-width": "260px",
      "rail-collapsed-width": "56px",
      "report-measure": "68ch",
      "content-max": "1180px",
      "breakpoint-sm": "480px",
      "breakpoint-md": "768px",
      "breakpoint-lg": "1024px",
      "breakpoint-xl": "1280px"
    }
  },

  "size": {
    "target-min": "24px",
    "target-default": "32px",
    "target-coarse": "44px",
    "control-height-sm": "32px",
    "control-height-md": "40px",
    "control-height-lg": "44px",
    "icon-sm": "16px",
    "icon-md": "20px",
    "trace-dot": "7px",
    "trace-rule": "2px",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px"
  },

  "radius": {
    "radius-0": "0",
    "radius-sm": "3px",
    "radius-md": "5px",
    "radius-lg": "6px",
    "radius-dot": "9999px",
    "rule": "Nothing above 6px except radius-dot, which is reserved for the trace spine's checkpoint marks — a data mark, not a container."
  },

  "elevation": {
    "light": {
      "elev-0": "none",
      "elev-1": "0 1px 2px rgba(23, 43, 49, 0.06)",
      "elev-2": "0 4px 12px rgba(23, 43, 49, 0.10)",
      "elev-3": "0 12px 32px rgba(23, 43, 49, 0.16)"
    },
    "dark": {
      "elev-0": "none",
      "elev-1": "0 1px 2px rgba(0, 0, 0, 0.45)",
      "elev-2": "0 4px 12px rgba(0, 0, 0, 0.55)",
      "elev-3": "0 12px 32px rgba(0, 0, 0, 0.65)"
    },
    "rules": [
      "Default separation is a 1px border-subtle rule, not a shadow. elev-0 is the norm.",
      "elev-1 applies only to sticky chrome once content scrolls beneath it.",
      "elev-2 applies to the export disclosure panel and the thread overflow menu.",
      "elev-3 applies to the delete-confirmation dialog and the mobile threads drawer.",
      "In dark mode shadows carry almost no signal; every elevated surface must ALSO step from canvas #0E1A1E to surface #15252B (a 1.12 luminance step) and carry a border-strong outline."
    ]
  },

  "motion": {
    "duration": {
      "dur-instant": "0ms",
      "dur-fast": "120ms",
      "dur-base": "160ms",
      "dur-slow": "240ms",
      "dur-ambient": "2400ms"
    },
    "easing": {
      "ease-standard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "ease-enter": "cubic-bezier(0, 0, 0.2, 1)",
      "ease-exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "assignments": {
      "focus-ring": "dur-fast / ease-standard",
      "hover-tint": "dur-fast / ease-standard",
      "checkpoint-tick-appear": "dur-fast opacity only / ease-enter",
      "disclosure-open": "dur-base / ease-enter",
      "disclosure-close": "dur-base / ease-exit",
      "mobile-drawer": "dur-slow / ease-standard (the only duration above 180ms; justified because it travels the full viewport width)",
      "stream-receiving-indicator": "dur-ambient opacity 1 -> 0.55 -> 1, infinite, ONLY while an EventSource is open"
    },
    "reducedMotion": {
      "query": "@media (prefers-reduced-motion: reduce)",
      "policy": [
        "All transition-duration and animation-duration become 1ms; no transform-based entrances.",
        "stream-receiving-indicator becomes a static filled mark plus the word 'Live'.",
        "The mobile drawer appears and disappears without translation.",
        "Report heading anchors use scroll-behavior: auto.",
        "No state in the product is conveyed by motion alone, so removing motion removes no information."
      ]
    }
  },

  "status": {
    "$note": "Status is never conveyed by colour alone. Each status carries a distinct mark shape and a distinct word.",
    "observed-checkpoint": { "colour": "signature", "mark": "filled circle", "word": "observed" },
    "receiving": { "colour": "signature", "mark": "filled circle with ring", "word": "Live" },
    "not-observed": { "colour": "ink-faint", "mark": "dashed rule", "word": "not observed" },
    "pending_review": { "colour": "review", "mark": "outlined diamond", "word": "Waiting for your review" },
    "succeeded": { "colour": "signature", "mark": "filled square", "word": "Complete" },
    "failed": { "colour": "critical", "mark": "square with a diagonal slash", "word": "Failed" },
    "cancelled": { "colour": "ink-muted", "mark": "hollow square", "word": "Cancelled" },
    "expired-or-unknown": { "colour": "ink-faint", "mark": "dashed square", "word": "No longer available" }
  }
}
