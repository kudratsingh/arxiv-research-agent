      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices"
        ],
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.5600000000002,
          "uploadThroughputKbps": 675,
