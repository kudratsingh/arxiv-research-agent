name: agent-ae72ba156d632425f
services:
  app:
    build:
      context: /Users/kudratsingh/Machine-Learning-Projects/arxiv-research-agent/.claude/worktrees/agent-ae72ba156d632425f
      dockerfile: Dockerfile
    command:
      - python
      - -m
      - src.api.serve
    container_name: arxiv-research-agent-app
    depends_on:
      postgres:
        condition: service_healthy
        required: true
      redis:
        condition: service_healthy
        required: true
    environment:
      ANTHROPIC_API_KEY: dummy
      API_CORS_ALLOW_ORIGINS: ""
      API_HOST: 0.0.0.0
      API_KEY_HOURLY_LIMIT: "20"
      API_KEYS: web:dummy
      API_PORT: "8000"
      CHECKPOINT_BACKEND: postgres
      CONVERSATION_STORE: postgres
      EMBEDDING_CACHE: postgres
      ENABLE_API_AUTH: "true"
      ENABLE_JOB_REDRIVER: "true"
      ENABLE_PROMPT_ISOLATION: "true"
      JOB_STORE: redis
      LOG_LEVEL: INFO
      MAX_COST_USD: "2.00"
      PAPER_CACHE: postgres
      POSTGRES_URL: postgresql://arxiv:dummy@postgres:5432/arxiv
      RATE_LIMIT_BACKEND: redis
      REDIS_URL: redis://redis:6379/0
    healthcheck:
      test:
        - CMD
        - curl
        - -fsS
        - http://localhost:8000/healthz
      timeout: 3s
      interval: 15s
      retries: 3
      start_period: 20s
    image: arxiv-research-agent:local
    networks:
      default: null
    restart: unless-stopped
    stop_grace_period: 30s
  caddy:
    container_name: arxiv-research-agent-caddy
    depends_on:
      web:
        condition: service_healthy
        required: true
    environment:
      ACME_EMAIL: ci@example.invalid
      APP_DOMAIN: ci.example.invalid
      APP_PASSWORD_HASH: dummy
      APP_USERNAME: ci
    healthcheck:
      test:
        - CMD
        - curl
        - -fsS
        - http://localhost:2019/config/
      timeout: 3s
      interval: 15s
      retries: 3
      start_period: 5s
    image: caddy:2.11.4-alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "80"
        protocol: tcp
      - mode: ingress
        target: 443
        published: "443"
        protocol: tcp
    read_only: true
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    volumes:
      - type: bind
        source: /Users/kudratsingh/Machine-Learning-Projects/arxiv-research-agent/.claude/worktrees/agent-ae72ba156d632425f/deploy/hetzner/Caddyfile
        target: /etc/caddy/Caddyfile
        read_only: true
        bind: {}
      - type: volume
        source: caddy-data
        target: /data
        volume: {}
      - type: volume
        source: caddy-config
        target: /config
        volume: {}
  postgres:
    container_name: arxiv-research-agent-postgres
    environment:
      POSTGRES_DB: arxiv
      POSTGRES_PASSWORD: dummy
      POSTGRES_USER: arxiv
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB
      timeout: 3s
      interval: 10s
      retries: 5
      start_period: 10s
    image: postgres:16-alpine
    networks:
      default: null
    restart: unless-stopped
    volumes:
      - type: volume
        source: postgres-data
        target: /var/lib/postgresql/data
        volume: {}
  redis:
    command:
      - redis-server
      - --appendonly
      - 'yes'
    container_name: arxiv-research-agent-redis
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      timeout: 3s
      interval: 10s
      retries: 3
    image: redis:7-alpine
    networks:
      default: null
    restart: unless-stopped
    volumes:
      - type: volume
        source: redis-data
        target: /data
        volume: {}
  web:
    build:
      context: /Users/kudratsingh/Machine-Learning-Projects/arxiv-research-agent/.claude/worktrees/agent-ae72ba156d632425f/web
      dockerfile: Dockerfile
    container_name: arxiv-research-agent-web
    depends_on:
      app:
        condition: service_healthy
        required: true
    environment:
      API_INTERNAL_BASE: http://app:8000
      ARXIV_API_KEY: dummy
      CSP_MODE: enforce
    healthcheck:
      test:
        - CMD
        - node
        - scripts/healthcheck.mjs
      timeout: 3s
      interval: 15s
      retries: 3
      start_period: 10s
    image: arxiv-research-agent-web:local
    networks:
      default: null
    restart: unless-stopped
networks:
  default:
    name: agent-ae72ba156d632425f_default
volumes:
  caddy-config:
    name: agent-ae72ba156d632425f_caddy-config
  caddy-data:
    name: agent-ae72ba156d632425f_caddy-data
  postgres-data:
    name: agent-ae72ba156d632425f_postgres-data
  redis-data:
