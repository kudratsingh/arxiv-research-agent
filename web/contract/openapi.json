        "operationId": "list_conversations_conversations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Page size \u2014 at most this many conversations come back.",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size \u2014 at most this many conversations come back."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Rows to skip, counted within the caller's own conversations, newest first.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Rows to skip, counted within the caller's own conversations, newest first."
          }
        ],
        "responses": {
