node_modules
.next
out
coverage
.DS_Store
*.log

# `npm run build-storybook` (WO-06). The static build goes here rather than
# to storybook-static because web/tests/tokens.test.ts scans every file
# under web/ for literal colours and skips only node_modules, .next, out,
# build and .git — a bundle under any other name turns the local test run
# red. Also ignored by the repository .gitignore and by eslint.config.mjs.
build

# Generated by tsc --noEmit; changes on every typecheck run.
tsconfig.tsbuildinfo

# next-env.d.ts is auto-generated by `next dev`/`next build`; skip
# from source control since it changes with Next.js versions.
next-env.d.ts

# Written by `npm run budgets` (WO-23) on every run; uploaded as a CI
# artifact and collected into the gate evidence pack, not source-controlled.
budget-report.md

# Written by `npm run audit:gate` (WO-24) on every run — the full
# `npm audit --json` body. Uploaded as a CI artifact and collected by WO-33,
# not source-controlled. `audit-exceptions.json`, which IS source-controlled,
# is the input; this is the output.
npm-audit.json

# `lhci collect`'s scratch directory (WO-29). It holds the raw LHRs between
# `collect` and `assert` and is cleared at the start of every profile by
# `scripts/lhci-run.mjs`. The copies worth keeping are written to build/lhci/
# by the `upload` step, which `build` above already ignores.
.lighthouseci

# Re-generated by `next dev` on every start
# (node_modules/next/dist/server/lib/generate-agent-files.js). CLAUDE.md is
# already ignored by the repository .gitignore; AGENTS.md was not, so it showed
# up untracked in any worktree that had run the dev server — which WO-21's
# `npm run e2e` now does, for the one scenario that needs a development build.
AGENTS.md
