# `npm run build-storybook` (WO-06). The static build goes here rather than
# to storybook-static because web/tests/tokens.test.ts scans every file
# under web/ for literal colours and skips only node_modules, .next, out,
# build and .git — a bundle under any other name turns the local test run
# red. Also ignored by the repository .gitignore and by eslint.config.mjs.
build

# Generated by tsc --noEmit; changes on every typecheck run.
tsconfig.tsbuildinfo

# next-env.d.ts is auto-generated by `next dev`/`next build`; skip
# from source control since it changes with Next.js versions.
next-env.d.ts

# Written by `npm run budgets` (WO-23) on every run; uploaded as a CI
# artifact and collected into the gate evidence pack, not source-controlled.
budget-report.md
