{
  "name": "arxiv-research-agent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Demo web UI for the arxiv-research-agent HTTP API.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "budgets": "npm run build && node scripts/route-budgets.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "lhci": "node scripts/lhci-run.mjs",
    "start": "next start -p 3000",
    "lint": "eslint app components lib middleware.ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir build/storybook",
    "generate:types": "openapi-typescript ./contract/openapi.json --output ./lib/api/generated/schema.d.ts",
    "contract:check": "bash ./contract/check-generated-types.sh",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "e2e:stack:up": "bash ./e2e/support/stack.sh up",
    "e2e:stack:seed": "bash ./e2e/support/stack.sh seed",
    "e2e:stack:down": "bash ./e2e/support/stack.sh down",
    "e2e:visual": "playwright test e2e/visual.spec.ts --project=chromium",
    "e2e:visual:update": "playwright test e2e/visual.spec.ts --project=chromium --update-snapshots",
    "e2e:pilot:stack:up": "E2E_PILOT=1 bash ./e2e/support/stack.sh up",
    "e2e:pilot:stack:seed": "E2E_PILOT=1 bash ./e2e/support/stack.sh seed",
    "e2e:pilot:stack:down": "E2E_PILOT=1 bash ./e2e/support/stack.sh down",
    "e2e:pilot": "E2E_PILOT=1 playwright test -c playwright.pilot.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tanstack/react-query": "5.102.2",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.86.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "web-vitals": "6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.4.47",
    "storybook": "10.5.10",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  }
}
